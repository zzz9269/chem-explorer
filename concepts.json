     "wiki": "Michaelis–Menten kinetics",
     "terms": ["zero-order", "zero order", "first-order", "saturable", "saturation", "saturated", "nonlinear", "non-linear", "Michaelis", "dose-dependent", "disproportionate", "capacity-limited"],
     "with_drug": "concept"},
    {"id": "steady_state", "label": "Steady state",
     "patterns": ["steady[- ]state"],
     "wiki": "Pharmacokinetics",
     "terms": ["steady state", "steady-state", "accumulation", "half-lives"],
